rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helper: is the signed-in user an admin?
    // Admins are documents in the `admins` collection whose document ID
    // is the user's email address (lowercase), e.g. admins/principal@school.edu
    // ------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // ------------------------------------------------------------------
    // Helper: is the given activity id an "Athletics" ECA?
    // Used to enforce the rule that 2 ECAs must include an Athletics one.
    // ------------------------------------------------------------------
    function isAthleticsEca(activityId) {
      return exists(/databases/$(database)/documents/activities/$(activityId)) &&
        get(/databases/$(database)/documents/activities/$(activityId)).data.category == "Athletics";
    }

    function seatMigrationRunning() {
      let migration = /databases/$(database)/documents/system/seatCountMigration;
      return exists(migration) &&
        get(migration).data.expiresAt is timestamp &&
        get(migration).data.expiresAt > request.time;
    }

    function studentHasActivity(studentDoc, activityId) {
      return studentDoc.data.cca is list &&
        studentDoc.data.eca is list &&
        (activityId in studentDoc.data.cca || activityId in studentDoc.data.eca);
    }

    function seatCountMatchesStudentChange(activityId, delta) {
      let student = /databases/$(database)/documents/students/$(request.auth.token.email.lower());
      return exists(student) &&
        (
          (
            delta == 1 &&
            !studentHasActivity(get(student), activityId) &&
            studentHasActivity(getAfter(student), activityId)
          ) ||
          (
            delta == -1 &&
            studentHasActivity(get(student), activityId) &&
            !studentHasActivity(getAfter(student), activityId)
          )
        );
    }

    function isValidSeatCountUpdate(activityId) {
      let oldCount = resource.data.seatCount;
      let newCount = request.resource.data.seatCount;
      let delta = newCount - oldCount;
      return isSignedIn() &&
        !seatMigrationRunning() &&
        oldCount is int &&
        newCount is int &&
        newCount >= 0 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["seatCount"]) &&
        seatCountMatchesStudentChange(activityId, delta) &&
        (
          delta == -1 ||
          (
            delta == 1 &&
            (resource.data.capacity == 0 || newCount <= resource.data.capacity)
          )
        );
    }

    // ------------------------------------------------------------------
    // admins collection: only the Firebase console / Admin SDK may write.
    // To make yourself admin: create a document with ID = your email.
    // ------------------------------------------------------------------
    match /admins/{email} {
      allow read: if isSignedIn();
      allow write: if false; // manage from the Firebase console
    }

    // ------------------------------------------------------------------
    // activities collection: details and authoritative seat counts live in
    // one document. Students may move only seatCount by one; all descriptive
    // fields remain admin-only.
    // ------------------------------------------------------------------
    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isValidSeatCountUpdate(activityId);
    }

    // ------------------------------------------------------------------
    // students collection: doc ID = student email (lowercase).
    // PRIVACY: only admins may list the roster; a student may read ONLY
    // their own document. Activity documents include `seatCount`, so students
    // can see "spots left" without reading other students' docs.
    // - a student may update only their OWN document, only the fields
    //   the app writes, and must keep at least 2 activities in total
    //   whenever they submit/change choices (admins may still clear choices)
    // - admins may do everything (add students, view, reset choices)
    // ------------------------------------------------------------------
    match /students/{email} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.token.email.lower() == email);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.token.email.lower() == email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "cca", "eca", "submittedAt", "name", "className", "email"
        ]) &&
        // "At least 2 activities in any mix, with at most 2 ECAs" — enforced
        // server-side whenever the choice fields change (name-only syncs are
        // unaffected). The `is list` guards reject type-confusion writes
        // (e.g. a string). Picking 2 ECAs also requires at least one to be an
        // Athletics ECA (the app writes `category` on ECA activities).
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["cca", "eca"]) ||
          (
            !seatMigrationRunning() &&
            request.resource.data.cca is list &&
            request.resource.data.eca is list &&
            request.resource.data.cca.size() + request.resource.data.eca.size() >= 2 &&
            request.resource.data.eca.size() <= 2 &&
            (
              request.resource.data.eca.size() != 2 ||
              isAthleticsEca(request.resource.data.eca[0]) ||
              isAthleticsEca(request.resource.data.eca[1])
            )
          )
        )
      );
    }

    // ------------------------------------------------------------------
    // Legacy seats documents are retained temporarily for rollback. The app
    // no longer reads or writes them after activity seatCount migration.
    // ------------------------------------------------------------------
    match /seats/{activityId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /system/{document} {
      allow read, write: if isAdmin();
    }
  }
}
