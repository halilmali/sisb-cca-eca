rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helper: is the signed-in user an admin?
    // Admins are documents in the `admins` collection whose document ID
    // is the user's email address (lowercase), e.g. admins/principal@school.edu
    // ------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // ------------------------------------------------------------------
    // admins collection: only the Firebase console / Admin SDK may write.
    // To make yourself admin: create a document with ID = your email.
    // ------------------------------------------------------------------
    match /admins/{email} {
      allow read: if isSignedIn();
      allow write: if false; // manage from the Firebase console
    }

    // ------------------------------------------------------------------
    // activities collection: any signed-in user (student or admin) can
    // read. Only admins can create / edit / delete activities.
    // ------------------------------------------------------------------
    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // students collection: doc ID = student email (lowercase).
    // PRIVACY: only admins may list the roster; a student may read ONLY
    // their own document. The app's student view reads the `seats`
    // collection for "spots left" instead of other students' docs.
    // - a student may update only their OWN document, only the fields
    //   the app writes, and must keep at least 1 CCA and 1 ECA whenever
    //   they submit/change choices (admins may still clear choices)
    // - admins may do everything (add students, view, reset choices)
    // ------------------------------------------------------------------
    match /students/{email} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.token.email.lower() == email);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.token.email.lower() == email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "cca", "eca", "submittedAt", "name", "className", "email"
        ]) &&
        // "Choose 1 to 2 CCAs and 1 to 2 ECAs" — enforced server-side
        // whenever the choice fields change (name-only syncs are unaffected).
        // The `is list` guards reject type-confusion writes (e.g. a string).
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["cca", "eca"]) ||
          (
            request.resource.data.cca is list &&
            request.resource.data.eca is list &&
            request.resource.data.cca.size() >= 1 &&
            request.resource.data.cca.size() <= 2 &&
            request.resource.data.eca.size() >= 1 &&
            request.resource.data.eca.size() <= 2
          )
        )
      );
    }

    // ------------------------------------------------------------------
    // seats collection: quota counters for each activity (doc ID = the
    // activity's ID, shape { count: number }). The app updates them inside
    // a Firestore transaction (saveChoices / clearChoices / deleteStudent),
    // which is what makes the quota rule race-free.
    //
    // SECURITY NOTE: these rules allow any signed-in user to adjust a
    // counter by +/-1, because the rule language can't verify that the
    // student is actually enrolling in the same transaction. The quota is
    // therefore enforced for students who use the app (the honest path).
    // For hard guarantees against a hostile client, move the quota check
    // to a server-side Cloud Function / Admin SDK.
    // ------------------------------------------------------------------
    match /seats/{activityId} {
      allow read: if isSignedIn();
      allow delete: if isAdmin();
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.count == 1);
      allow update: if isSignedIn() && (
        request.resource.data.count == resource.data.count + 1 ||
        request.resource.data.count == resource.data.count - 1
      ) && request.resource.data.count >= 0;
    }
  }
}
